# The UI can select either mode; LLM remains the startup default.
TRADING_MODE=llm
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Agent reasoning uses Sol; override only if this API project lacks access.
OPENAI_AGENT_MODEL=gpt-6-sol
# Optional explicit strategy path. Relative paths resolve under the code checkout.
TRADING_STRATEGY_PATH=
AGENT_MAX_TURNS=24
AGENT_TIMEOUT_SECONDS=180
CAPITAL_USER_ID=
CAPITAL_PASSWORD=
