# PLANNEDLIMIT CLI branch: both UI modes use Codex CLI and ChatGPT plan quota.
TRADING_MODE=agent
# No API key is required. API-key login is refused and there is no API fallback.
# Optional native CLI executable path (auto-detected from PATH / Codex desktop).
CODEX_CLI_PATH=
# Optional Codex model override; otherwise use OPENAI_AGENT_MODEL for Agents.
CODEX_MODEL=
OPENAI_MODEL=gpt-5.6-luna
# Agent reasoning uses Sol; select a model available to your Codex account.
OPENAI_AGENT_MODEL=gpt-6-sol
# Optional explicit strategy path. Relative paths resolve under the code checkout.
TRADING_STRATEGY_PATH=
AGENT_MAX_TURNS=24
AGENT_TIMEOUT_SECONDS=180
CAPITAL_USER_ID=
CAPITAL_PASSWORD=
